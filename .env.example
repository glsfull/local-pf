# Необязательные настройки окружения внутри контейнера.
# CHROME_PATH=/usr/bin/google-chrome
# LOG_DIR=/app/logs
# Панель на хосте может указать путь к той же папке через --agent-log-dir.

# Необязательные настройки парсера выдачи.
# LOCAL_PF_RESULTS_URL=https://ya.ru/search/
# LOCAL_PF_OBSERVATION_DELAY=1.0
# LOCAL_PF_RESULT_LINK_SELECTOR=li.serp-item a.OrganicTitle-Link, li.serp-item h2 > a
# LOCAL_PF_EMPTY_RESULTS_SELECTOR=.EmptySearchResults, .SearchEmpty

# SmartCaptcha при проверке позиций из панели (для config.yaml — ключи CAPTCHA_*).
# LOCAL_PF_CAPTCHA_ATTEMPTS=3
# LOCAL_PF_CAPTCHA_TIMEOUT=300
# LOCAL_PF_CAPTCHA_POLL=2
# LOCAL_PF_OPERATOR_URL=http://localhost:56565
# Локальная модель для капчи с картинками: модуль:функция.
# LOCAL_PF_CAPTCHA_SOLVER=examples.captcha_solver_fixed:solve
# LOCAL_PF_CAPTCHA_POINTS=50,60;200,120

# Yandex Search API, отложенные запросы (agent.py --source api, панель --search-api).
# YANDEX_SEARCH_API_KEY=
# YANDEX_SEARCH_FOLDER_ID=
# LOCAL_PF_API_POLL_SECONDS=60
# LOCAL_PF_API_TIMEOUT_SECONDS=14400
