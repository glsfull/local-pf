# Необязательные настройки окружения внутри контейнера.
# CHROME_PATH=/usr/bin/google-chrome
# LOG_DIR=/app/logs
# Панель на хосте может указать путь к той же папке через --agent-log-dir.

# Необязательные настройки парсера выдачи.
# LOCAL_PF_RESULTS_URL=https://ya.ru/search/
# LOCAL_PF_OBSERVATION_DELAY=1.0
# LOCAL_PF_RESULT_LINK_SELECTOR=li.serp-item a.OrganicTitle-Link, li.serp-item h2 > a
# LOCAL_PF_EMPTY_RESULTS_SELECTOR=.EmptySearchResults, .SearchEmpty

# Съём позиций через Yandex Search API (отложенные запросы).
# Ключ API сервисного аккаунта с ролью search-api.webSearch.user и ID каталога Yandex Cloud.
# Значения из «Настроек панели» имеют приоритет над этими переменными.
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=

# Адрес окна агента (noVNC), если контейнер опубликован не на порту 56565.
# LOCAL_PF_NOVNC_URL=http://localhost:56565/
